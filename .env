# ========================================
# FEATURE FLAGS
# ========================================
# Enable/disable specific features
ENABLE_TWITTER=true
ENABLE_REDDIT=true
ENABLE_FACEBOOK=false
ENABLE_TELEGRAM=false
ENABLE_NEWSAPI=true

# ========================================
# SECURITY SETTINGS
# ========================================
